name: "musetalk"
backend: "python"

max_batch_size: 0

input [
  {
    name: "AUDIO"
    data_type: TYPE_FP32
    dims: [ -1 ]   # complete audio samples (24kHz)
  },
  {
    name: "FRAME_INDEX"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  }
]

output [
  {
    name: "VIDEO_FRAME"
    data_type: TYPE_UINT8
    dims: [ -1 ]     # JPEG-encoded video frame bytes
  },
  {
    name: "FRAME_INDEX"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "TIMESTAMP_MS"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

model_transaction_policy {
  decoupled: true
}

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

parameters: {
  key: "unet_model_path"
  value: { string_value: "/local_models/musetalk_model/musetalkV15/unet.pth" }
}

parameters: {
  key: "unet_config"
  value: { string_value: "/local_models/musetalk_model/musetalkV15/musetalk.json" }
}

parameters: {
  key: "unet_onnx_path"
  value: { string_value: "/local_models/musetalk_model/musetalkV15/unet.onnx" }
}

parameters: {
  key: "use_onnx_unet"
  value: { string_value: "true" }
}

parameters: {
  key: "vae_type"
  value: { string_value: "sd-vae" }
}

parameters: {
  key: "vae_model_path"
  value: { string_value: "/local_models/musetalk_model/sd-vae" }
}

parameters: {
  key: "whisper_dir"
  value: { string_value: "/local_models/musetalk_model/whisper" }
}

parameters: {
  key: "avatar_root"
  value: { string_value: "/local_models/musetalk_model/testing_avatar_creation/v15/avatars" }
}

parameters: {
  key: "default_avatar_id"
  value: { string_value: "default" }
}

parameters: {
  key: "face_parse_resnet_path"
  value: { string_value: "/local_models/musetalk_model/face-parse-bisent/resnet18-5c106cde.pth" }
}

parameters: {
  key: "face_parse_model_path"
  value: { string_value: "/local_models/musetalk_model/face-parse-bisent/79999_iter.pth" }
}

parameters: {
  key: "fps"
  value: { string_value: "25" }
}

parameters: {
  key: "batch_size"
  value: { string_value: "8" }
}

parameters: {
  key: "audio_padding_left"
  value: { string_value: "2" }
}

parameters: {
  key: "audio_padding_right"
  value: { string_value: "2" }
}
