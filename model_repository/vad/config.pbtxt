name: "vad"
backend: "python"

input [
  {
    name: "AUDIO_PCM"
    data_type: TYPE_FP32
    dims: [ -1 ]  # 1D variable-length audio chunk
  }
]

output [
  {
    name: "IS_SPEECH"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "PROB"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "END_OF_UTTERANCE"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

instance_group [
  { kind: KIND_CPU }
]

max_batch_size: 0
